# ============================================================
# 观星录 · 环境变量示例
# ------------------------------------------------------------
# 复制为 .env.local 后填写。.env* 已在 .gitignore 中，
# 不会进入 Git，也不会进入构建产物。
#
# 全部为可选：不配置时排盘、起卦、黄历、术语、记录全部可用，
# 仅「AI 语言转译」会降级为提示配置。
# ============================================================

# 服务商：openai（默认，兼容任何 OpenAI Chat Completions 网关）| anthropic
AI_PROVIDER=openai

# 密钥。只在服务端读取，永不下发前端，也不写入日志。
AI_API_KEY=

# 接口地址。留空则使用官方地址：
#   openai    -> https://api.openai.com/v1
#   anthropic -> https://api.anthropic.com/v1
# 使用国内兼容网关时填其 base url，例如 https://api.example.com/v1
AI_BASE_URL=

# 模型名。留空则使用默认值（openai: gpt-4o-mini / anthropic: claude-sonnet-4-20250514）
AI_MODEL=
